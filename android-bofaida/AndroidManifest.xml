<?xml version="1.0" encoding="utf-8"?>
<!--
  غلاف أندرويد لموقع BOFAIDA ADS.

  التطبيق كلّه داخل الملف: صفحاته وأصوله في assets/www، ويُقدَّمها النشاط نفسه
  على أصل https داخلي، فيعمل بلا إنترنت من أول تشغيل، ويحفظ بياناته كما يحفظها
  المتصفّح تماماً.
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="dz.bofaida.ads"
    android:versionCode="1"
    android:versionName="1.0.0">

  <uses-sdk android:minSdkVersion="23" android:targetSdkVersion="34" />

  <!-- لفتح روابط واتساب والاتصال، ولأي مزامنة مستقبلية. التطبيق نفسه لا يحتاجها. -->
  <uses-permission android:name="android.permission.INTERNET" />

  <application
      android:label="@string/app_name"
      android:icon="@mipmap/ic_launcher"
      android:theme="@style/AppTheme"
      android:supportsRtl="true"
      android:hardwareAccelerated="true"
      android:allowBackup="true"
      android:usesCleartextTraffic="false">

    <activity
        android:name=".MainActivity"
        android:exported="true"
        android:launchMode="singleTask"
        android:windowSoftInputMode="adjustResize"
        android:configChanges="orientation|screenSize|keyboardHidden|screenLayout|smallestScreenSize|uiMode|fontScale">
      <intent-filter>
        <action android:name="android.intent.action.MAIN" />
        <category android:name="android.intent.category.LAUNCHER" />
      </intent-filter>
    </activity>
  </application>
</manifest>

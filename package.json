{
  "name": "herfah-pro",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "حرفة برو - تطبيق إدارة أعمال الحرفيين والتجار",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build && node site/copy-to-dist.mjs",
    "preview": "vite preview",
    "site": "node site/serve.mjs",
    "deploy": "npm run build && npx --yes firebase-tools@13 deploy --only hosting",
    "typecheck": "tsc -b --noEmit false --emitDeclarationOnly false",
    "lint": "tsc -b"
  },
  "dependencies": {
    "firebase": "^11.1.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.28.0"
  },
  "devDependencies": {
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "typescript": "^5.6.3",
    "vite": "^6.0.3"
  }
}

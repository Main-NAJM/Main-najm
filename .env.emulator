# إعدادات محاكي Firebase — تُحمَّل فقط مع ‎--mode emulator‎.
#
# لا تحوي أي سرّ: المحاكي لا يتحقّق من المفاتيح، ويقبل أي قيمة غير فارغة.
# لهذا يُرفع هذا الملف إلى Git، بخلاف ‎.env.local‎ الذي يحمل مفاتيح مشروعك الحقيقي.
#
#   npm run emulators        # نافذة أولى — يشغّل Auth و Firestore محليًا
#   npm run dev:emulator     # نافذة ثانية — يشغّل التطبيق موصولًا بهما
#
# واجهة المحاكي: http://127.0.0.1:4000

VITE_FIREBASE_API_KEY=demo-emulator-key
VITE_FIREBASE_AUTH_DOMAIN=localhost
VITE_FIREBASE_PROJECT_ID=albacha-metals-fecd8
VITE_FIREBASE_STORAGE_BUCKET=albacha-metals-fecd8.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=000000000000
VITE_FIREBASE_APP_ID=1:000000000000:web:demoemulator

# تفعيل الوصل بالمحاكي
VITE_FIREBASE_EMULATORS=1
VITE_FIREBASE_EMULATOR_HOST=127.0.0.1
VITE_FIREBASE_AUTH_EMULATOR_PORT=9099
VITE_FIREBASE_FIRESTORE_EMULATOR_PORT=8080

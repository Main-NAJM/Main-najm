# إعدادات Firebase — انسخ هذا الملف إلى .env.local واملأ القيم من إعدادات مشروعك.
# Firebase Console → Project settings → Your apps → Web app → SDK setup and configuration
#
# إذا تركت هذه القيم فارغة سيعمل التطبيق في الوضع المحلي (تخزين داخل المتصفّح فقط).
#
# ولتجربة المزامنة وقواعد الأمان بلا مشروع سحابي ولا فاتورة، لا تحتاج هذا الملف
# أصلًا — استخدم المحاكي: `npm run emulators` ثم `npm run dev:emulator`.
# التفاصيل في README قسم «محاكي Firebase».

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

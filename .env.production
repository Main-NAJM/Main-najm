# إعدادات Firebase للويب — تُحمَّل في كل بناء إنتاج (npm run build و build:pages).
#
# لماذا هذا الملف مرفوع إلى Git، بخلاف ‎.env.local‎:
#
# مفاتيح Firebase للويب ليست أسراراً. تُشحن داخل حزمة جافاسكربت التي يحمّلها
# كل زائر، فيقرؤها أي أحد من مصدر الصفحة — هذا تصميم Firebase لا تسريب.
# الحماية تأتي من قواعد ‎firestore.rules‎ (يفحصها ‎npm run test:rules‎)،
# لا من إخفاء ‎apiKey‎.
#
# وكان بقاؤها خارج Git هو سبب عطل حقيقي: ‎.env.local‎ غير مرفوع، فكل بناء
# على GitHub Pages كان يخرج بلا مفاتيح، فيعمل التطبيق المنشور في «الوضع
# المحلي» وحده — بلا أي مزامنة سحابية، منذ أول نشر.
#
# السرّ الحقيقي الوحيد هو مفتاح حساب الخدمة (Admin SDK)، ومكانه خزنة أسرار
# GitHub باسم FIREBASE_SERVICE_ACCOUNT. لا يوضع هنا أبداً.
#
# لتشديد إضافي (اختياري، من Google Cloud Console):
#   APIs & Services ← Credentials ← مفتاح الويب ← Application restrictions
#   ← HTTP referrers ← أضف نطاقاتك فقط.

VITE_FIREBASE_API_KEY=AIzaSyC91OFvMReKqz5nLwJjVSx0_zEFORZ5eRI
VITE_FIREBASE_AUTH_DOMAIN=albacha-metals-fecd8.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=albacha-metals-fecd8
VITE_FIREBASE_STORAGE_BUCKET=albacha-metals-fecd8.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=379093155638
VITE_FIREBASE_APP_ID=1:379093155638:web:903d928937a71e92c6fd97

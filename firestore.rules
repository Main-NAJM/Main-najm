rules_version = '2';

// قواعد أمان Firestore لتطبيق حرفة برو:
// كل مستخدم يقرأ ويكتب بياناته فقط تحت users/{uid}.
service cloud.firestore {
  match /databases/{database}/documents {

    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;

      match /{collectionName}/{docId} {
        allow read, write: if request.auth != null
          && request.auth.uid == userId
          && collectionName in [
            // تطبيق حرفة برو
            'orders',
            'appointments',
            'calculations',
            'marketPrices',
            'debts',
            'products',
            'inventory',
            // تطبيق مؤسسة الباشة (مجموعات مستقلّة حتى لا تختلط البيانات)
            'albachaCustomers',
            'albachaOrders',
            'albachaMaterials',
            'albachaPhotos',
            // استوديو بوفايدة (وثيقة واحدة تحمل المشاريع والأسعار)
            'studio'
          ];
      }
    }

    // ------------------------------------------------------------------
    // متجر أم عمر: واجهة عامّة، بخلاف ما سبق.
    //
    // المنتجات يقرأها الجميع بلا تسجيل دخول — فالزبونة تتصفّح المتجر كأي موقع.
    // ولا يكتبها إلا الحساب المذكور أدناه، وهو الحارس الحقيقي: لوحة الإدارة في
    // الصفحة مجرّد نموذج، ومن فتحها بلا صلاحية تُرفض كتاباته هنا.
    //
    // ضعي مكان السطر أدناه معرّف حسابك (UID) من:
    //   Firebase Console ← Authentication ← Users ← عمود User UID
    // ويمكن إضافة أكثر من معرّف بينها فاصلة.
    // ما دام المعرّف النموذجي كما هو، تُرفض كل كتابة — وهذا الوضع الآمن.
    // ------------------------------------------------------------------
    match /shop/{shopId} {
      allow read: if true;
      // مستند المتجر يحمل الإعدادات التي تحفظها لوحة التحكّم (الاسم والحسابات
      // والنصوص والفيديوهات) — نفس صاحب المنتجات هو من يكتبها.
      allow write: if request.auth != null
        && request.auth.uid in ['ضعي-معرّف-حسابك-هنا'];

      match /products/{productId} {
        allow read: if true;
        allow write: if request.auth != null
          && request.auth.uid in ['ضعي-معرّف-حسابك-هنا'];
      }
    }

    // منع الوصول إلى أي مسار آخر.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}

rules_version = '2';

// قواعد أمان Firestore لتطبيق حرفة برو:
// كل مستخدم يقرأ ويكتب بياناته فقط تحت users/{uid}.
service cloud.firestore {
  match /databases/{database}/documents {

    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;

      match /{collectionName}/{docId} {
        allow read, write: if request.auth != null
          && request.auth.uid == userId
          && collectionName in [
            // تطبيق حرفة برو
            'orders',
            'appointments',
            'calculations',
            'marketPrices',
            'debts',
            // تطبيق مؤسسة الباشة (مجموعات مستقلّة حتى لا تختلط البيانات)
            'albachaCustomers',
            'albachaOrders',
            'albachaMaterials',
            'albachaPhotos'
          ];
      }
    }

    // ---------------------------------------------------------------
    // الموقع التعريفي: يقرأه كل الزوّار بلا حساب، ويكتبه المالك وحده.
    // المالك = ownerUid في siteConfig/main، ويُثبَّت عند أول إنشاء للوثيقة
    // من حساب مسجَّل (أول من يفتح لوحة الموقع في التطبيق يملكها).
    // ---------------------------------------------------------------
    function siteOwner() {
      return get(/databases/$(database)/documents/siteConfig/main).data.ownerUid;
    }
    function siteClaimed() {
      return exists(/databases/$(database)/documents/siteConfig/main);
    }
    function isSiteOwner() {
      return request.auth != null && siteClaimed() && request.auth.uid == siteOwner();
    }

    match /siteConfig/{docId} {
      allow read: if true;
      // أول مطالبة: وثيقة main فقط، من حساب مسجَّل، وبمعرّفه هو، ومرّة واحدة.
      allow create: if request.auth != null
        && docId == 'main'
        && !siteClaimed()
        && request.resource.data.ownerUid == request.auth.uid;
      // التعديل لا يغيّر المالك.
      allow update: if isSiteOwner() && request.resource.data.ownerUid == siteOwner();
      allow delete: if false;
    }

    match /siteGallery/{photoId} {
      allow read: if true;
      allow write: if isSiteOwner();
    }

    // ---------------------------------------------------------------
    // طلبات عروض الأسعار الواردة من نموذج الموقع.
    //
    // يكتبها أي زائر بلا حساب — وهذا مقصود، فالزبون لا يسجّل دخولاً. ولأنها
    // مفتوحة للكتابة، تحصر القاعدة ما يُكتب: حقول بعينها لا غير، بأنواع وأطوال
    // محدودة، وبحالة 'new' دائماً. ولا يقرأها أحد سوى المالك، فلا يرى زائرٌ
    // أرقامَ هواتف غيره.
    // ---------------------------------------------------------------
    function validRequest() {
      let d = request.resource.data;
      return d.keys().hasOnly(
               ['id', 'name', 'phone', 'kind', 'width', 'height', 'qty', 'note', 'status', 'createdAt']
             )
        && d.keys().hasAll(['name', 'phone', 'kind', 'status', 'createdAt'])
        && d.name is string && d.name.size() >= 2 && d.name.size() <= 60
        && d.phone is string && d.phone.size() >= 6 && d.phone.size() <= 20
        && d.kind in ['aluminium', 'iron', 'kitchen', 'railing', 'other']
        && (!('note' in d) || (d.note is string && d.note.size() <= 500))
        && (!('width' in d) || (d.width is number && d.width >= 0 && d.width <= 2000))
        && (!('height' in d) || (d.height is number && d.height >= 0 && d.height <= 2000))
        && (!('qty' in d) || (d.qty is number && d.qty >= 0 && d.qty <= 1000))
        && d.status == 'new'
        && d.createdAt is number;
    }

    match /siteRequests/{requestId} {
      allow create: if validRequest();
      allow read, update, delete: if isSiteOwner();
    }

    // منع الوصول إلى أي مسار آخر.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
